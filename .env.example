PORT=3000
NODE_ENV=development

# Claves criptográficas JWT (HS256)
JWT_SECRET=tu_clave_secreta_jwt_para_tokens_de_acceso
JWT_REFRESH_SECRET=tu_clave_secreta_para_refresh_tokens

# Configuración de CORS
CORS_ORIGIN=http://localhost:3000

# Configuración SMTP para envío real de correos electrónicos
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=tu_contraseña_de_aplicacion_gmail
EMAIL_FROM="Portal de Noticias <no-reply@portalnoticias.edu.mx>"
